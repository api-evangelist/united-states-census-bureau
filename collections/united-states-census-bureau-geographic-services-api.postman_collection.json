                  "key": "address",
                  "value": "<string>",
                  "description": "(Required) Full address as a single string (e.g., \"4600 Silver Hill Rd, Washington DC 20233\")"
                },
                {
                  "disabled": false,
                  "key": "benchmark",
                  "value": "Public_AR_Current",
                  "description": "(Required) The geocoding benchmark to use (e.g., Public_AR_Current, Public_AR_Census2020)"
                },
                {
                  "disabled": false,
                  "key": "vintage",
                  "value": "<string>",
                  "description": "Geographic vintage for returned geography identifiers (e.g., Current_Current, Census2020_Census2020)"
