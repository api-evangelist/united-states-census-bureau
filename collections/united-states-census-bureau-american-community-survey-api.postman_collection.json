          "id": "7bcab5b5-1970-4ae9-9894-9d3620a46b10",
          "name": "Get ACS 1-Year Data",
          "request": {
            "name": "Get ACS 1-Year Data",
            "description": {
              "content": "Returns American Community Survey 1-Year Estimates for geographies with populations of 65,000 or more. Covers social, economic, demographic, and housing characteristics. Data available from 2005 to present.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":year",
                "acs",
                "acs1"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "get",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of variable names to retrieve (e.g., NAME,B01003_001E for name and total population). Maximum 50 variables per query."
                },
                {
                  "disabled": false,
                  "key": "for",
                  "value": "<string>",
                  "description": "Geographic level and FIPS code filter (e.g., state:01 for Alabama, county:*&in=state:06 for all CA counties)"
                },
                {
                  "disabled": false,
                  "key": "in",
                  "value": "<string>",
                  "description": "Parent geography constraint for sub-state geographies (e.g., state:06 to restrict to California)"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "Census API key for higher usage limits (500+ requests/day)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "year",
                  "description": "(Required) Data year (2005-2024)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
